# Direct-Order — environment variables
#
# Copy to .env and fill in real values for local development.
# NEVER commit a file containing real secrets.
#
# Variables marked [PHASE 1] are read by code that exists today.
# Everything else is reserved for later phases and documented here
# now so the full production configuration surface is visible from
# day one (see docs/10-infrastructure-deployment.md §16.3).

# ── Application ──────────────────────────────────────────────[PHASE 1]
NODE_ENV=development
APP_ENV=local
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
LOG_LEVEL=debug

# ── Database ─────────────────────────────────────────────────[PHASE 1]
DATABASE_URL=postgresql://direct_order:direct_order@localhost:5432/direct_order?schema=public
DATABASE_POOL_MAX=10

# ── Redis ────────────────────────────────────────────────────[PHASE 1, optional until Phase 12]
REDIS_URL=redis://localhost:6379

# ── Auth ─────────────────────────────────────────────────────[Phase 3]
JWT_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=30d
COOKIE_DOMAIN=localhost
ARGON2_MEMORY_KB=65536

# ── Payments (Razorpay) ──────────────────────────────────────[Phase 9]
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Delivery ─────────────────────────────────────────────────[Phase 11]
DELIVERY_PROVIDER=mock
UBER_DIRECT_CLIENT_ID=
UBER_DIRECT_CLIENT_SECRET=
UBER_DIRECT_WEBHOOK_SECRET=

# ── Notifications ────────────────────────────────────────────[Phase 12]
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
WHATSAPP_PROVIDER=console
GUPSHUP_API_KEY=
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=noreply@direct-order.local

# ── Storage ──────────────────────────────────────────────────[Phase 5]
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=direct-order-local
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
CDN_BASE_URL=http://localhost:9000/direct-order-local

# ── Observability ────────────────────────────────────────────[Phase 18]
SENTRY_DSN=
SENTRY_ENVIRONMENT=local

# ── Business configuration ───────────────────────────────────[Phase 8+]
PLATFORM_FEE_BPS=0
ORDER_PAYMENT_TTL_MINUTES=30
LOYALTY_POINTS_PER_100_INR=1
CART_TTL_HOURS=24

# ── Feature flags ────────────────────────────────────────────[Phase 14+]
DISCOVERY_ENABLED=false
LOYALTY_ENABLED=false
REFERRALS_ENABLED=false
REVIEWS_ENABLED=false
PROMOTIONS_ENABLED=false
PAYMENTS_LIVE_MODE=false
