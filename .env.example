# Direct-Order — environment variables
#
# Copy to .env and fill in real values for local development.
# NEVER commit a file containing real secrets.
#
# Variables tagged [PHASE N] are read by code that exists today —
# currently phases 1 through 12. Everything else is reserved for later
# phases and documented here now so the full production configuration
# surface is visible from day one (see docs/10-infrastructure-deployment.md §16.3).

# ── Application ──────────────────────────────────────────────[PHASE 1]
NODE_ENV=development
APP_ENV=local
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
LOG_LEVEL=debug
# Read by the browser (Next.js requires the NEXT_PUBLIC_ prefix to expose
# a variable client-side) — the API origin the web app's fetch client
# talks to (Phase 3). Same value as API_BASE_URL in local development;
# kept separate because the two are read by different processes.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# ── Database ─────────────────────────────────────────────────[PHASE 1/2]
# DATABASE_URL: the OWNER/migration role. Used by `prisma migrate` and
# `pnpm db:grants` — needs full DDL/GRANT privileges. Never used by the
# running application itself.
DATABASE_URL=postgresql://direct_order:direct_order@localhost:5432/direct_order?schema=public
# APP_DATABASE_URL: the RESTRICTED runtime role the API/worker actually
# connect as (Phase 2). Created by
# infrastructure/postgres/init/01-create-app-role.sql in local
# development; privileges applied by `pnpm db:grants` after migrations.
# In particular, this role can never UPDATE or DELETE audit_logs — see
# prisma/grants.sql. Production provisions its own equivalent role
# through the platform's secret manager, not this file.
APP_DATABASE_URL=postgresql://direct_order_app:direct_order_app@localhost:5432/direct_order?schema=public
DATABASE_POOL_MAX=10

# ── Redis ────────────────────────────────────────────────────[PHASE 3]
# Required from Phase 3 onward: rate limiting (docs/09-security.md §15.7)
# is Redis-backed so limits hold across multiple API instances.
REDIS_URL=redis://localhost:6379

# ── Auth ─────────────────────────────────────────────────────[PHASE 3]
# Generate a real value with: openssl rand -base64 48
JWT_SECRET=local-development-only-secret-change-me-32-chars-min
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_DOMAIN=localhost
ARGON2_MEMORY_KB=65536

# ── Payments (Razorpay) ──────────────────────────────────────[PHASE 9]
# `mock` is a fully-working in-memory simulator, safe for local dev and
# every automated test — there is no live network access to Razorpay
# here, and payment settlement structure (AMB-3) is explicitly BLOCKING
# / REQUIRES PRODUCT DECISION, so real money must never move on an
# assumption. Switch to `razorpay` (and fill in real keys below) only
# once that decision is made and credentials exist.
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Delivery ─────────────────────────────────────────────────[PHASE 11]
DELIVERY_PROVIDER=mock
UBER_DIRECT_CLIENT_ID=
UBER_DIRECT_CLIENT_SECRET=
UBER_DIRECT_WEBHOOK_SECRET=
UBER_DIRECT_CUSTOMER_ID=

# ── Notifications ────────────────────────────────────────────[PHASE 12]
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
WHATSAPP_PROVIDER=console
GUPSHUP_API_KEY=
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=noreply@direct-order.local

# ── Storage ──────────────────────────────────────────────────[PHASE 5]
# S3-compatible (MinIO locally, via docker-compose.yml) — presigned
# image uploads for restaurant branding (docs/09-security.md §15.6).
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=direct-order-local
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=us-east-1
CDN_BASE_URL=http://localhost:9000/direct-order-local

# ── Observability ────────────────────────────────────────────[Phase 18]
SENTRY_DSN=
SENTRY_ENVIRONMENT=local

# ── Business configuration ──────────────────────────────────────────
# Platform-wide fee, in basis points of the items subtotal (BR-14: may
# be zero during the pilot — the default). Consumed by the pricing
# engine (packages/money/src/pricing.ts) via CheckoutQuoteService.
PLATFORM_FEE_BPS=0                                            # [PHASE 8]
ORDER_PAYMENT_TTL_MINUTES=30                                  # [PHASE 9]
LOYALTY_POINTS_PER_100_INR=1                                  # [Phase 16]
CART_TTL_HOURS=24                                              # [PHASE 9]

# ── Feature flags ────────────────────────────────────────────[Phase 14+]
DISCOVERY_ENABLED=false
LOYALTY_ENABLED=false
REFERRALS_ENABLED=false
REVIEWS_ENABLED=false
PROMOTIONS_ENABLED=false
PAYMENTS_LIVE_MODE=false
