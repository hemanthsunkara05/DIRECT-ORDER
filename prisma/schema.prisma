// Direct-Order — Prisma schema
//
// Phase 2 (Core schema and tenancy): identity, restaurant-as-tenant,
// staff membership, and the append-only audit log.
// Phase 3 (Authentication) added: OtpChallenge, and Session.familyId
// for O(1) refresh-token-family revocation on reuse detection.
// Phase 6 (Menu management) added: MenuCategory, MenuItem.
// See PRODUCT/docs/01-domain-model.md §5.1–5.3 and
// PRODUCT/docs/02-database-schema.md for the authoritative field-level
// specification this schema implements.
//
// Deliberately excludes anything not yet needed: Customer, AdminUser
// (Phase 13), OperatingHours/SpecialHours/ClosurePeriod (Phase 7),
// MenuItemImage/search_vector (multi-image and full-text search are not
// needed until a phase actually consumes them). Do not add them ahead
// of the phase that needs them.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  DISABLED
}

/// Platform-controlled restaurant lifecycle (docs/03-state-machines.md §7.5).
/// Distinct from `Restaurant.onboardingStatus`, which tracks the owner's own
/// progress through the onboarding wizard and never gates public visibility
/// or ordering on its own — only `status` and `orderingEnabled` do that.
enum RestaurantStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  CLOSED
  REJECTED
}

enum RestaurantOnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum RestaurantStaffRole {
  OWNER
  MANAGER
  STAFF
}

/// A RestaurantStaff row is created only once an invitation is accepted
/// (see StaffInvitationStatus) — so its own status only ever needs to
/// express whether an existing membership is currently usable.
enum RestaurantStaffStatus {
  ACTIVE
  DISABLED
}

enum StaffInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum DietaryTag {
  VEG
  NON_VEG
  EGG
  UNKNOWN
}

// ─────────────────────────────────────────────────────────────────
// Identity
// ─────────────────────────────────────────────────────────────────

/// A human principal who can authenticate. Covers restaurant users and
/// (in later phases) admins and registered customers. Guests never get a
/// User row. Never hard-deleted — disabling revokes all sessions instead.
///
/// INVARIANT (enforced at the application/service layer for now — Prisma's
/// schema DSL cannot express a declarative "at least one of two nullable
/// columns is non-null" CHECK constraint; add one to the generated
/// migration when it exists): at least one of `email`/`phone` must be set.
model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  email           String?    @unique
  phone           String?    @unique
  passwordHash    String?    @map("password_hash")
  fullName        String     @map("full_name")
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz
  phoneVerifiedAt DateTime?  @map("phone_verified_at") @db.Timestamptz
  mfaSecret       String?    @map("mfa_secret")
  mfaEnabledAt    DateTime?  @map("mfa_enabled_at") @db.Timestamptz
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  sessions             Session[]
  restaurantStaff      RestaurantStaff[] @relation("StaffMember")
  staffMembersInvited  RestaurantStaff[] @relation("StaffInvitedBy")
  staffInvitationsSent StaffInvitation[] @relation("InvitationSentBy")

  @@map("users")
}

/// Server-side record making refresh tokens revocable (docs/09-security.md
/// §15.2). Every rotation (each `/auth/refresh` call) creates a NEW Session
/// row and revokes the old one — `familyId` is shared across every
/// generation of one continuous login, so reuse of an already-rotated
/// token (Phase 3 acceptance criterion) can revoke the whole family in one
/// indexed UPDATE rather than walking the `rotatedFromId` chain.
model Session {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  /// Shared by every rotation descending from the same original login.
  /// Equal to `id` for the first session in a family.
  familyId         String    @map("family_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipHash           String?   @map("ip_hash")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz
  /// Set when this row was created as the audit trail's "reuse detected"
  /// marker rather than a normal rotation — distinguishes an ordinary
  /// revoke (logout, password change) from a security event.
  revokedReason    String?   @map("revoked_reason")
  rotatedFromId    String?   @map("rotated_from_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("sessions")
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
  PASSWORD_RESET
}

/// Unified verification/challenge mechanism (docs/01-domain-model.md
/// §5.1). Serves two shapes of secret through the same table, varied by
/// `purpose` at the service layer: a short numeric OTP for
/// EMAIL_VERIFICATION/PHONE_VERIFICATION, and a long random link-token
/// for PASSWORD_RESET. Only the hash is ever persisted either way.
model OtpChallenge {
  id          String     @id @default(uuid(7)) @db.Uuid
  /// Email or phone the challenge was issued for — not necessarily tied
  /// to an existing User (e.g. registration verifies an email before the
  /// account is considered active).
  identifier  String
  purpose     OtpPurpose
  codeHash    String     @map("code_hash")
  attempts    Int        @default(0)
  maxAttempts Int        @default(5) @map("max_attempts")
  expiresAt   DateTime   @map("expires_at") @db.Timestamptz
  consumedAt  DateTime?  @map("consumed_at") @db.Timestamptz
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz

  @@index([identifier, purpose, consumedAt])
  @@index([expiresAt])
  // PASSWORD_RESET links carry only the token, not the identifier — this
  // index backs the by-hash lookup path (OtpService.verifyResetToken).
  @@index([codeHash, purpose, consumedAt])
  @@map("otp_challenges")
}

// ─────────────────────────────────────────────────────────────────
// Restaurant (tenant root)
// ─────────────────────────────────────────────────────────────────

/// The tenant. Every restaurant-owned resource in every later phase
/// carries a non-null restaurantId back to this table
/// (docs/02-database-schema.md §6.5, tenant isolation).
///
/// Slug format (lowercase alphanumeric + hyphens, 3–63 chars, reserved-word
/// check) is validated at the service layer in Phase 5, where restaurant
/// creation is actually implemented — only uniqueness is enforced here.
model Restaurant {
  id               String                     @id @default(uuid(7)) @db.Uuid
  slug             String                     @unique
  name             String
  description      String?
  phone            String?
  email            String?
  timezone         String                     @default("Asia/Kolkata")
  status           RestaurantStatus           @default(DRAFT)
  onboardingStatus RestaurantOnboardingStatus @default(NOT_STARTED) @map("onboarding_status")
  orderingEnabled  Boolean                    @default(false) @map("ordering_enabled")
  avgPrepMinutes   Int?                       @map("avg_prep_minutes")
  ratingAvg        Decimal?                   @map("rating_avg") @db.Decimal(3, 2)
  ratingCount      Int                        @default(0) @map("rating_count")
  createdAt        DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime                   @updatedAt @map("updated_at") @db.Timestamptz

  address        RestaurantAddress?
  branding       RestaurantBranding?
  settings       RestaurantSettings?
  staff          RestaurantStaff[]
  invitations    StaffInvitation[]
  menuCategories MenuCategory[]
  menuItems      MenuItem[]

  @@index([status])
  @@map("restaurants")
}

/// Pickup address for delivery and the public location. 1:1 with
/// Restaurant; meaningless without it, hence CASCADE
/// (docs/02-database-schema.md §6.1, deletion policy).
model RestaurantAddress {
  id           String   @id @default(uuid(7)) @db.Uuid
  restaurantId String   @unique @map("restaurant_id") @db.Uuid
  line1        String
  line2        String?
  locality     String?
  city         String
  state        String
  postalCode   String   @map("postal_code")
  latitude     Decimal? @db.Decimal(9, 6)
  longitude    Decimal? @db.Decimal(9, 6)
  landmark     String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("restaurant_addresses")
}

/// Branding kept separate from Restaurant itself so the public ordering
/// page (Phase 7) can fetch it cheaply and independently.
model RestaurantBranding {
  id                String   @id @default(uuid(7)) @db.Uuid
  restaurantId      String   @unique @map("restaurant_id") @db.Uuid
  logoUrl           String?  @map("logo_url")
  coverImageUrl     String?  @map("cover_image_url")
  themePrimaryColor String?  @map("theme_primary_color")
  themeAccentColor  String?  @map("theme_accent_color")
  tagline           String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("restaurant_branding")
}

/// Operational configuration. Money fields are integer paise (`*Minor`,
/// BigInt) per INV-1/BR-1 — never a float, never a Decimal used for
/// arithmetic. `deliveryFeeMode` stays a plain string for now rather than
/// an enum: Phase 11 (delivery integration) will determine the real set of
/// modes once there is an actual provider to model against; formalising it
/// here would be guessing ahead of that requirement.
model RestaurantSettings {
  id                   String   @id @default(uuid(7)) @db.Uuid
  restaurantId         String   @unique @map("restaurant_id") @db.Uuid
  minOrderAmountMinor  BigInt   @default(0) @map("min_order_amount_minor")
  packagingFeeMinor    BigInt   @default(0) @map("packaging_fee_minor")
  deliveryFeeMode      String   @default("FLAT") @map("delivery_fee_mode")
  deliveryFeeFlatMinor BigInt   @default(0) @map("delivery_fee_flat_minor")
  acceptsOnlinePayment Boolean  @default(false) @map("accepts_online_payment")
  autoAcceptOrders     Boolean  @default(false) @map("auto_accept_orders")
  notificationEmails   String[] @map("notification_emails")
  notificationPhones   String[] @map("notification_phones")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("restaurant_settings")
}

/// Membership linking a User to a Restaurant with a role. Created only
/// once a StaffInvitation is accepted — see StaffInvitationStatus; there
/// is deliberately no INVITED value on RestaurantStaffStatus itself.
///
/// INVARIANT enforced at the service layer (Phase 5): every restaurant
/// must retain at least one ACTIVE OWNER; the last one cannot be disabled
/// or have its role changed.
model RestaurantStaff {
  id              String                @id @default(uuid(7)) @db.Uuid
  userId          String                @map("user_id") @db.Uuid
  restaurantId    String                @map("restaurant_id") @db.Uuid
  role            RestaurantStaffRole
  status          RestaurantStaffStatus @default(ACTIVE)
  invitedByUserId String?               @map("invited_by_user_id") @db.Uuid
  joinedAt        DateTime              @default(now()) @map("joined_at") @db.Timestamptz
  disabledAt      DateTime?             @map("disabled_at") @db.Timestamptz
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  user          User       @relation("StaffMember", fields: [userId], references: [id], onDelete: Restrict)
  invitedByUser User?      @relation("StaffInvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  // Phase 2 acceptance criterion: duplicate (user_id, restaurant_id) fails
  // at the database level, not just in application code.
  @@unique([userId, restaurantId])
  @@index([restaurantId, status])
  @@map("restaurant_staff")
}

/// Single-use, expiring invitation. The raw token exists only in the
/// emailed link (Phase 5) — only its hash is ever persisted.
model StaffInvitation {
  id              String                @id @default(uuid(7)) @db.Uuid
  restaurantId    String                @map("restaurant_id") @db.Uuid
  email           String
  role            RestaurantStaffRole
  status          StaffInvitationStatus @default(PENDING)
  tokenHash       String                @unique @map("token_hash")
  invitedByUserId String                @map("invited_by_user_id") @db.Uuid
  expiresAt       DateTime              @map("expires_at") @db.Timestamptz
  acceptedAt      DateTime?             @map("accepted_at") @db.Timestamptz
  revokedAt       DateTime?             @map("revoked_at") @db.Timestamptz
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz

  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  invitedByUser User       @relation("InvitationSentBy", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@index([restaurantId, status])
  @@index([email])
  @@map("staff_invitations")
}

// ─────────────────────────────────────────────────────────────────
// Catalog (Phase 6)
// ─────────────────────────────────────────────────────────────────

/// Groups MenuItems for display. `(restaurantId, name)` uniqueness among
/// non-archived rows is enforced at the service layer (MenuCategoryService),
/// not a DB constraint — Prisma's schema DSL cannot express a partial
/// unique index (docs/02-database-schema.md pattern already used for
/// User's email-or-phone invariant), and this repo has no live database
/// in this sandbox to apply a hand-written migration against anyway.
model MenuCategory {
  id           String    @id @default(uuid(7)) @db.Uuid
  restaurantId String    @map("restaurant_id") @db.Uuid
  name         String
  description  String?
  displayOrder Int       @default(0) @map("display_order")
  isActive     Boolean   @default(true) @map("is_active")
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      MenuItem[]

  @@index([restaurantId, displayOrder])
  @@map("menu_categories")
}

/// **Three distinct states, do not conflate** (docs/01-domain-model.md
/// §5.3): `isActive` (exists on the menu) · `isAvailable` (orderable
/// right now — the one field STAFF, not just MANAGER/OWNER, can toggle)
/// · `archivedAt` (removed from the menu, retained for history).
/// **Never hard-deleted** — a later phase's order references this row
/// for display context even after archiving, alongside its own price
/// snapshot taken at order time.
model MenuItem {
  id           String     @id @default(uuid(7)) @db.Uuid
  restaurantId String     @map("restaurant_id") @db.Uuid
  categoryId   String     @map("category_id") @db.Uuid
  name         String
  description  String?
  priceMinor   BigInt     @map("price_minor")
  currency     String     @default("INR")
  imageUrl     String?    @map("image_url")
  isAvailable  Boolean    @default(true) @map("is_available")
  isActive     Boolean    @default(true) @map("is_active")
  displayOrder Int        @default(0) @map("display_order")
  dietaryTag   DietaryTag @default(UNKNOWN) @map("dietary_tag")
  archivedAt   DateTime?  @map("archived_at") @db.Timestamptz
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  restaurant Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([restaurantId, categoryId, displayOrder])
  @@map("menu_items")
}

// ─────────────────────────────────────────────────────────────────
// Audit
// ─────────────────────────────────────────────────────────────────

/// Append-only record of every privileged or state-changing action
/// (docs/02-database-schema.md, audit_logs). No `@relation` to the entities
/// it references: an audit record must remain exactly as it was recorded
/// even if the referenced restaurant/entity is later modified, and must
/// never be blocked from being written by a foreign-key constraint.
///
/// The application's own AuditRepository (apps/api/src/platform/audit)
/// exposes create + read only — no update, no delete — as the first layer
/// of enforcement. `prisma/grants.sql` revokes UPDATE/DELETE on this table
/// from the restricted runtime database role as the second, database-level
/// layer (defence in depth: an application bug reaching for `$executeRaw`
/// still cannot rewrite history).
model AuditLog {
  id            String   @id @default(uuid(7)) @db.Uuid
  actorType     String   @map("actor_type")
  actorId       String?  @map("actor_id") @db.Uuid
  action        String
  entityType    String   @map("entity_type")
  entityId      String?  @map("entity_id") @db.Uuid
  restaurantId  String?  @map("restaurant_id") @db.Uuid
  before        Json?
  after         Json?
  reason        String?
  correlationId String?  @map("correlation_id")
  ipHash        String?  @map("ip_hash")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([actorType, actorId, createdAt(sort: Desc)])
  @@index([restaurantId, createdAt(sort: Desc)])
  @@map("audit_logs")
}
