// Direct-Order — Prisma schema
//
// Phase 2 (Core schema and tenancy): identity, restaurant-as-tenant,
// staff membership, and the append-only audit log.
// Phase 3 (Authentication) added: OtpChallenge, and Session.familyId
// for O(1) refresh-token-family revocation on reuse detection.
// Phase 6 (Menu management) added: MenuCategory, MenuItem.
// Phase 7 (Public ordering page) added: OperatingHours, SpecialHours,
// ClosurePeriod — the data isAcceptingOrders() evaluates.
// See PRODUCT/docs/01-domain-model.md §5.1–5.3 and
// PRODUCT/docs/02-database-schema.md for the authoritative field-level
// specification this schema implements.
//
// Deliberately excludes anything not yet needed: Customer, AdminUser
// (Phase 13), MenuItemImage/search_vector (multi-image and full-text
// search are not needed until a phase actually consumes them). Do not
// add them ahead of the phase that needs them.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  DISABLED
}

/// Platform-controlled restaurant lifecycle (docs/03-state-machines.md §7.5).
/// Distinct from `Restaurant.onboardingStatus`, which tracks the owner's own
/// progress through the onboarding wizard and never gates public visibility
/// or ordering on its own — only `status` and `orderingEnabled` do that.
enum RestaurantStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  CLOSED
  REJECTED
}

enum RestaurantOnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum RestaurantStaffRole {
  OWNER
  MANAGER
  STAFF
}

/// A RestaurantStaff row is created only once an invitation is accepted
/// (see StaffInvitationStatus) — so its own status only ever needs to
/// express whether an existing membership is currently usable.
enum RestaurantStaffStatus {
  ACTIVE
  DISABLED
}

enum StaffInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum DietaryTag {
  VEG
  NON_VEG
  EGG
  UNKNOWN
}

enum CustomerStatus {
  ACTIVE
  DISABLED
}

enum CartStatus {
  OPEN
  CONVERTED
  ABANDONED
}

/// The full graph from docs/03-state-machines.md §7.1. Phase 9 only
/// ever drives PENDING_PAYMENT → PLACED/PAYMENT_FAILED/EXPIRED through
/// real endpoints — every other edge, including PAYMENT_FAILED →
/// PENDING_PAYMENT retry, ACCEPTED/PREPARING/READY_FOR_PICKUP/
/// REJECTED/CANCELLED, and the delivery states, is reachable in the
/// state machine service (one service per aggregate, built complete
/// now) but has no HTTP path yet. The retry edge was originally
/// planned as a Phase 9 endpoint; it was deferred on review because it
/// is not in docs/04-api-specification.md §8.3's endpoint table, none
/// of the ten named failure scenarios in §18.3 require it, and doing
/// it correctly needs the same "re-validate and re-price" machinery as
/// checkout itself (docs/03 §7.1's transition table: "re-validate and
/// re-price" is the PAYMENT_FAILED → PENDING_PAYMENT precondition) —
/// better bundled with Phase 10's order-management work than rushed
/// here. Restaurant-driven transitions arrive with Phase 10; delivery
/// states with Phase 11.
enum OrderStatus {
  PENDING_PAYMENT
  PLACED
  PAYMENT_FAILED
  EXPIRED
  ACCEPTED
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  REJECTED
  CANCELLED
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_DELIVERY
}

enum PromotionRedemptionStatus {
  RESERVED
  CONFIRMED
  RELEASED
}

enum ReviewStatus {
  PENDING_REVIEW
  PUBLISHED
  HIDDEN
  REMOVED
}

enum ReviewReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum LoyaltyAccountStatus {
  ACTIVE
  DISABLED
}

/// docs/01 §5.9's exact six values — treated as a closed set. A
/// redemption's checkout-time hold is represented by LoyaltyRedemption
/// (RESERVED/CONFIRMED/RELEASED), not by a seventh ledger type, so a
/// released reservation never needs a compensating ledger row — it
/// simply never produces one, keeping every ledger row a genuine,
/// permanent fact (BR-97, "never updated or deleted").
enum LoyaltyLedgerType {
  ORDER_EARN
  REDEMPTION
  REFUND_CLAWBACK
  ADMIN_ADJUSTMENT
  EXPIRATION
  REFERRAL_REWARD
}

/// BR-102 ("reserved at checkout and confirmed on payment capture,
/// mirroring coupons") — same three-state shape as
/// PromotionRedemptionStatus, same RESERVED -> CONFIRMED/RELEASED
/// transitions driven by the same ORDER_PLACED / ORDER_PAYMENT_FAILED /
/// ORDER_EXPIRED outbox events LoyaltyOutboxConsumer subscribes to.
enum LoyaltyRedemptionStatus {
  RESERVED
  CONFIRMED
  RELEASED
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  REWARDED
  EXPIRED
  INVALIDATED
}

/// docs/03-state-machines.md §7.2. A payment's status is a field
/// separate from the order's — never merged (domain model note).
enum PaymentStatus {
  CREATED
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

/// docs/03-state-machines.md §7.3.
enum RefundStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  FAILED
}

/// docs/03-state-machines.md §7.4. A delivery failure never corrupts
/// payment records — this status is entirely independent of
/// `PaymentStatus`/`RefundStatus`.
enum DeliveryStatus {
  PENDING_CREATION
  CREATED
  CREATION_FAILED
  SEARCHING_COURIER
  COURIER_ASSIGNED
  AT_PICKUP
  PICKED_UP
  NO_COURIER_FOUND
  DELIVERED
  CANCELLED
  FAILED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

enum ReconciliationSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReconciliationIssueStatus {
  OPEN
  INVESTIGATING
  RESOLVED
}

enum OutboxStatus {
  PENDING
  PROCESSED
  FAILED
}

/// docs/08-search-and-notifications.md §14.2.
enum NotificationChannel {
  IN_APP
  SMS
  WHATSAPP
  EMAIL
  PUSH
}

/// docs/08 §14.3. TRANSACTIONAL and SECURITY are never disableable —
/// enforced in `NotificationPreferenceService`, not just documented here.
enum NotificationCategory {
  SECURITY
  TRANSACTIONAL
  ACCOUNT
  MARKETING
}

/// Mirrors `OrderActorType`'s shape (order-state.service.ts) — a
/// notification recipient is always one of these, resolved from the
/// triggering domain event, never client-supplied (BR-148).
enum NotificationRecipientType {
  CUSTOMER
  RESTAURANT_USER
  ADMIN
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  DEAD_LETTERED
  SUPPRESSED
}

// ─────────────────────────────────────────────────────────────────
// Identity
// ─────────────────────────────────────────────────────────────────

/// A human principal who can authenticate. Covers restaurant users and
/// (in later phases) admins and registered customers. Guests never get a
/// User row. Never hard-deleted — disabling revokes all sessions instead.
///
/// INVARIANT (enforced at the application/service layer for now — Prisma's
/// schema DSL cannot express a declarative "at least one of two nullable
/// columns is non-null" CHECK constraint; add one to the generated
/// migration when it exists): at least one of `email`/`phone` must be set.
model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  email           String?    @unique
  phone           String?    @unique
  passwordHash    String?    @map("password_hash")
  fullName        String     @map("full_name")
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz
  phoneVerifiedAt DateTime?  @map("phone_verified_at") @db.Timestamptz
  mfaSecret       String?    @map("mfa_secret")
  mfaEnabledAt    DateTime?  @map("mfa_enabled_at") @db.Timestamptz
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  sessions              Session[]
  restaurantStaff       RestaurantStaff[] @relation("StaffMember")
  staffMembersInvited   RestaurantStaff[] @relation("StaffInvitedBy")
  staffInvitationsSent  StaffInvitation[] @relation("InvitationSentBy")
  closurePeriodsCreated ClosurePeriod[]   @relation("ClosurePeriodCreatedBy")
  adminUser             AdminUser?
  /// Phase 16: set only for a registered "lightweight optional account"
  /// (docs/01 §5.1: "has ... optional one Customer"). A User backing a
  /// restaurant staff member or admin has no Customer row — the two
  /// principal kinds are not required to overlap.
  customer              Customer?

  @@map("users")
}

/// Server-side record making refresh tokens revocable (docs/09-security.md
/// §15.2). Every rotation (each `/auth/refresh` call) creates a NEW Session
/// row and revokes the old one — `familyId` is shared across every
/// generation of one continuous login, so reuse of an already-rotated
/// token (Phase 3 acceptance criterion) can revoke the whole family in one
/// indexed UPDATE rather than walking the `rotatedFromId` chain.
model Session {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  /// Shared by every rotation descending from the same original login.
  /// Equal to `id` for the first session in a family.
  familyId         String    @map("family_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipHash           String?   @map("ip_hash")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz
  /// Set when this row was created as the audit trail's "reuse detected"
  /// marker rather than a normal rotation — distinguishes an ordinary
  /// revoke (logout, password change) from a security event.
  revokedReason    String?   @map("revoked_reason")
  rotatedFromId    String?   @map("rotated_from_id") @db.Uuid
  /// Phase 13: set only once a valid TOTP code has been verified for
  /// THIS session (`POST /auth/mfa/verify`) — never copied from a prior
  /// session on rotation. `AuthGuard` already re-fetches the live
  /// Session row on every request (never trusts the JWT alone, per this
  /// model's own established pattern), so `AuthorizationGuard`'s admin
  /// branch checking this column is immediately effective on the very
  /// next request, the same "revocation takes effect now, not at token
  /// expiry" guarantee logout/reuse-detection already rely on.
  mfaVerifiedAt    DateTime? @map("mfa_verified_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("sessions")
}

/// docs/05-authorization-matrix.md §9.1: "Admin roles are not ordered" —
/// deliberately a flat enum, not a numeric level, mirroring
/// `permission.catalogue.ts`'s `AdminRole` union exactly (kept as the
/// single source of truth for the matrix itself; this enum only needs
/// to match its string values).
enum AdminRole {
  SUPPORT
  ADMIN_OPERATIONS
  ADMIN_FINANCE
  SUPER_ADMIN
}

enum AdminUserStatus {
  ACTIVE
  DISABLED
}

/// docs/01-domain-model.md §5.2 (AdminUser): "Platform-staff role
/// assignment, kept separate from restaurant membership so admin
/// privilege can never be acquired through restaurant paths." MFA is
/// enforced at the API (`AuthorizationGuard`), not just documented here
/// — see that guard's own doc comment. The "at least one active
/// SUPER_ADMIN" invariant is enforced at the service layer
/// (`AdminUserService`), the same "documented in the model, enforced in
/// the service" split `LastOwnerError` already established for
/// restaurant OWNERs.
model AdminUser {
  id        String          @id @default(uuid(7)) @db.Uuid
  userId    String          @unique @map("user_id") @db.Uuid
  role      AdminRole
  status    AdminUserStatus @default(ACTIVE)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_users")
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
  PASSWORD_RESET
  /// Phase 16: AMB-2's "lightweight optional account" — docs/01 §5.1
  /// already documents OtpChallenge's purpose as "Phone/email
  /// verification and customer login", so this completes a
  /// purpose the model always anticipated rather than adding a new
  /// concept. Same numeric-code path as PHONE_VERIFICATION (6 digits,
  /// 5-minute expiry, 5 attempts) — OtpService branches only on
  /// PASSWORD_RESET, so no service-layer change was needed to support it.
  CUSTOMER_LOGIN
}

/// Unified verification/challenge mechanism (docs/01-domain-model.md
/// §5.1). Serves two shapes of secret through the same table, varied by
/// `purpose` at the service layer: a short numeric OTP for
/// EMAIL_VERIFICATION/PHONE_VERIFICATION, and a long random link-token
/// for PASSWORD_RESET. Only the hash is ever persisted either way.
model OtpChallenge {
  id          String     @id @default(uuid(7)) @db.Uuid
  /// Email or phone the challenge was issued for — not necessarily tied
  /// to an existing User (e.g. registration verifies an email before the
  /// account is considered active).
  identifier  String
  purpose     OtpPurpose
  codeHash    String     @map("code_hash")
  attempts    Int        @default(0)
  maxAttempts Int        @default(5) @map("max_attempts")
  expiresAt   DateTime   @map("expires_at") @db.Timestamptz
  consumedAt  DateTime?  @map("consumed_at") @db.Timestamptz
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz

  @@index([identifier, purpose, consumedAt])
  @@index([expiresAt])
  // PASSWORD_RESET links carry only the token, not the identifier — this
  // index backs the by-hash lookup path (OtpService.verifyResetToken).
  @@index([codeHash, purpose, consumedAt])
  @@map("otp_challenges")
}

// ─────────────────────────────────────────────────────────────────
// Restaurant (tenant root)
// ─────────────────────────────────────────────────────────────────

/// The tenant. Every restaurant-owned resource in every later phase
/// carries a non-null restaurantId back to this table
/// (docs/02-database-schema.md §6.5, tenant isolation).
///
/// Slug format (lowercase alphanumeric + hyphens, 3–63 chars, reserved-word
/// check) is validated at the service layer in Phase 5, where restaurant
/// creation is actually implemented — only uniqueness is enforced here.
model Restaurant {
  id               String                     @id @default(uuid(7)) @db.Uuid
  slug             String                     @unique
  name             String
  description      String?
  phone            String?
  email            String?
  timezone         String                     @default("Asia/Kolkata")
  status           RestaurantStatus           @default(DRAFT)
  onboardingStatus RestaurantOnboardingStatus @default(NOT_STARTED) @map("onboarding_status")
  orderingEnabled  Boolean                    @default(false) @map("ordering_enabled")
  avgPrepMinutes   Int?                       @map("avg_prep_minutes")
  ratingAvg        Decimal?                   @map("rating_avg") @db.Decimal(3, 2)
  ratingCount      Int                        @default(0) @map("rating_count")
  createdAt        DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime                   @updatedAt @map("updated_at") @db.Timestamptz

  address        RestaurantAddress?
  branding       RestaurantBranding?
  settings       RestaurantSettings?
  staff          RestaurantStaff[]
  invitations    StaffInvitation[]
  menuCategories MenuCategory[]
  menuItems      MenuItem[]
  operatingHours OperatingHours[]
  specialHours   SpecialHours[]
  closurePeriods ClosurePeriod[]
  carts          Cart[]
  orders         Order[]
  promotions     Promotion[]
  reviews        Review[]
  supportCases   SupportCase[]
  dailyMetrics   DailyRestaurantMetrics[]

  @@index([status])
  @@map("restaurants")
}

/// Pickup address for delivery and the public location. 1:1 with
/// Restaurant; meaningless without it, hence CASCADE
/// (docs/02-database-schema.md §6.1, deletion policy).
model RestaurantAddress {
  id           String   @id @default(uuid(7)) @db.Uuid
  restaurantId String   @unique @map("restaurant_id") @db.Uuid
  line1        String
  line2        String?
  locality     String?
  city         String
  state        String
  postalCode   String   @map("postal_code")
  latitude     Decimal? @db.Decimal(9, 6)
  longitude    Decimal? @db.Decimal(9, 6)
  landmark     String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("restaurant_addresses")
}

/// Branding kept separate from Restaurant itself so the public ordering
/// page (Phase 7) can fetch it cheaply and independently.
model RestaurantBranding {
  id                String   @id @default(uuid(7)) @db.Uuid
  restaurantId      String   @unique @map("restaurant_id") @db.Uuid
  logoUrl           String?  @map("logo_url")
  coverImageUrl     String?  @map("cover_image_url")
  themePrimaryColor String?  @map("theme_primary_color")
  themeAccentColor  String?  @map("theme_accent_color")
  tagline           String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("restaurant_branding")
}

/// Operational configuration. Money fields are integer paise (`*Minor`,
/// BigInt) per INV-1/BR-1 — never a float, never a Decimal used for
/// arithmetic. `deliveryFeeMode` stays a plain string for now rather than
/// an enum: Phase 11 (delivery integration) will determine the real set of
/// modes once there is an actual provider to model against; formalising it
/// here would be guessing ahead of that requirement.
model RestaurantSettings {
  id                   String   @id @default(uuid(7)) @db.Uuid
  restaurantId         String   @unique @map("restaurant_id") @db.Uuid
  minOrderAmountMinor  BigInt   @default(0) @map("min_order_amount_minor")
  packagingFeeMinor    BigInt   @default(0) @map("packaging_fee_minor")
  deliveryFeeMode      String   @default("FLAT") @map("delivery_fee_mode")
  deliveryFeeFlatMinor BigInt   @default(0) @map("delivery_fee_flat_minor")
  acceptsOnlinePayment Boolean  @default(false) @map("accepts_online_payment")
  autoAcceptOrders     Boolean  @default(false) @map("auto_accept_orders")
  notificationEmails   String[] @map("notification_emails")
  notificationPhones   String[] @map("notification_phones")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("restaurant_settings")
}

/// Membership linking a User to a Restaurant with a role. Created only
/// once a StaffInvitation is accepted — see StaffInvitationStatus; there
/// is deliberately no INVITED value on RestaurantStaffStatus itself.
///
/// INVARIANT enforced at the service layer (Phase 5): every restaurant
/// must retain at least one ACTIVE OWNER; the last one cannot be disabled
/// or have its role changed.
model RestaurantStaff {
  id              String                @id @default(uuid(7)) @db.Uuid
  userId          String                @map("user_id") @db.Uuid
  restaurantId    String                @map("restaurant_id") @db.Uuid
  role            RestaurantStaffRole
  status          RestaurantStaffStatus @default(ACTIVE)
  invitedByUserId String?               @map("invited_by_user_id") @db.Uuid
  joinedAt        DateTime              @default(now()) @map("joined_at") @db.Timestamptz
  disabledAt      DateTime?             @map("disabled_at") @db.Timestamptz
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  user          User       @relation("StaffMember", fields: [userId], references: [id], onDelete: Restrict)
  invitedByUser User?      @relation("StaffInvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  // Phase 2 acceptance criterion: duplicate (user_id, restaurant_id) fails
  // at the database level, not just in application code.
  @@unique([userId, restaurantId])
  @@index([restaurantId, status])
  @@map("restaurant_staff")
}

/// Single-use, expiring invitation. The raw token exists only in the
/// emailed link (Phase 5) — only its hash is ever persisted.
model StaffInvitation {
  id              String                @id @default(uuid(7)) @db.Uuid
  restaurantId    String                @map("restaurant_id") @db.Uuid
  email           String
  role            RestaurantStaffRole
  status          StaffInvitationStatus @default(PENDING)
  tokenHash       String                @unique @map("token_hash")
  invitedByUserId String                @map("invited_by_user_id") @db.Uuid
  expiresAt       DateTime              @map("expires_at") @db.Timestamptz
  acceptedAt      DateTime?             @map("accepted_at") @db.Timestamptz
  revokedAt       DateTime?             @map("revoked_at") @db.Timestamptz
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz

  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  invitedByUser User       @relation("InvitationSentBy", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@index([restaurantId, status])
  @@index([email])
  @@map("staff_invitations")
}

// ─────────────────────────────────────────────────────────────────
// Catalog (Phase 6)
// ─────────────────────────────────────────────────────────────────

/// Groups MenuItems for display. `(restaurantId, name)` uniqueness among
/// non-archived rows is enforced at the service layer (MenuCategoryService),
/// not a DB constraint — Prisma's schema DSL cannot express a partial
/// unique index (docs/02-database-schema.md pattern already used for
/// User's email-or-phone invariant), and this repo has no live database
/// in this sandbox to apply a hand-written migration against anyway.
model MenuCategory {
  id           String    @id @default(uuid(7)) @db.Uuid
  restaurantId String    @map("restaurant_id") @db.Uuid
  name         String
  description  String?
  displayOrder Int       @default(0) @map("display_order")
  isActive     Boolean   @default(true) @map("is_active")
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      MenuItem[]

  @@index([restaurantId, displayOrder])
  @@map("menu_categories")
}

/// **Three distinct states, do not conflate** (docs/01-domain-model.md
/// §5.3): `isActive` (exists on the menu) · `isAvailable` (orderable
/// right now — the one field STAFF, not just MANAGER/OWNER, can toggle)
/// · `archivedAt` (removed from the menu, retained for history).
/// **Never hard-deleted** — a later phase's order references this row
/// for display context even after archiving, alongside its own price
/// snapshot taken at order time.
model MenuItem {
  id           String     @id @default(uuid(7)) @db.Uuid
  restaurantId String     @map("restaurant_id") @db.Uuid
  categoryId   String     @map("category_id") @db.Uuid
  name         String
  description  String?
  priceMinor   BigInt     @map("price_minor")
  currency     String     @default("INR")
  imageUrl     String?    @map("image_url")
  isAvailable  Boolean    @default(true) @map("is_available")
  isActive     Boolean    @default(true) @map("is_active")
  displayOrder Int        @default(0) @map("display_order")
  dietaryTag   DietaryTag @default(UNKNOWN) @map("dietary_tag")
  archivedAt   DateTime?  @map("archived_at") @db.Timestamptz
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  restaurant Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([restaurantId, categoryId, displayOrder])
  @@map("menu_items")
}

// ─────────────────────────────────────────────────────────────────
// Availability (Phase 7) — the data isAcceptingOrders() evaluates.
// Precedence: Restaurant.status → ClosurePeriod → SpecialHours →
// OperatingHours → Restaurant.orderingEnabled (docs/03-state-machines.md
// §"Ordering availability", docs/06-business-rules.md BR-67). All
// evaluated in the restaurant's own IANA timezone, never the server's.
// ─────────────────────────────────────────────────────────────────

/// Weekly recurring schedule. Multiple rows per `dayOfWeek` allow split
/// shifts (e.g. lunch 11:00–15:00, dinner 18:00–23:00). `closesAt <=
/// opensAt` denotes an overnight window spanning midnight (e.g.
/// 22:00→02:00) — AvailabilityService checks both the nominal day and
/// the following day for these. `opensAt`/`closesAt` are `@db.Time`
/// (wall-clock time-of-day only, no date or timezone component) — see
/// availability/time-of-day.ts for the epoch-date convention Prisma
/// Client represents them with.
model OperatingHours {
  id           String   @id @default(uuid(7)) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  /// 0 (Sunday) – 6 (Saturday), in the restaurant's own timezone.
  dayOfWeek    Int      @map("day_of_week")
  opensAt      DateTime @map("opens_at") @db.Time
  closesAt     DateTime @map("closes_at") @db.Time
  isClosed     Boolean  @default(false) @map("is_closed")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, dayOfWeek])
  @@map("operating_hours")
}

/// Date-specific override — takes precedence over OperatingHours for
/// that date entirely (docs/01-domain-model.md §5.2). One row per date:
/// there is no restaurant-facing write endpoint for this table in Phase
/// 7 (docs/04-api-specification.md §8.5 documents `/restaurant/hours`
/// and `/restaurant/closures` but no special-hours endpoint) — the
/// table and AvailabilityService's precedence logic exist and are fully
/// tested now so a later phase can add the write path without touching
/// the authority function itself.
model SpecialHours {
  id           String    @id @default(uuid(7)) @db.Uuid
  restaurantId String    @map("restaurant_id") @db.Uuid
  date         DateTime  @db.Date
  isClosed     Boolean   @default(false) @map("is_closed")
  opensAt      DateTime? @map("opens_at") @db.Time
  closesAt     DateTime? @map("closes_at") @db.Time
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, date])
  @@map("special_hours")
}

/// Temporary closure — e.g. a burst pipe or a family emergency, not a
/// scheduled day off. `endsAt: null` means indefinite, ended explicitly
/// via `POST /restaurant/closures/:id` (DELETE in the route, `end()` in
/// the service — sets `endsAt` to now rather than deleting the row, so
/// the closure stays in history).
model ClosurePeriod {
  id              String    @id @default(uuid(7)) @db.Uuid
  restaurantId    String    @map("restaurant_id") @db.Uuid
  startsAt        DateTime  @map("starts_at") @db.Timestamptz
  endsAt          DateTime? @map("ends_at") @db.Timestamptz
  reason          String?
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdBy  User       @relation("ClosurePeriodCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([restaurantId, startsAt])
  @@map("closure_periods")
}

// ─────────────────────────────────────────────────────────────────
// Ordering, payments, refunds (Phase 9) — docs/01-domain-model.md
// §5.4–5.6, docs/02-database-schema.md §6.3 (the DDL this schema
// reproduces), docs/03-state-machines.md §7.1–7.3.
// ─────────────────────────────────────────────────────────────────

/// The ordering party — may exist without a User (guest checkout,
/// docs/01 §5.4). `userId` set means a registered "lightweight optional
/// account" (AMB-2: phone-OTP, no password) created via Phase 16's
/// `POST /auth/customer/otp/verify`; `userId` null means guest — the
/// exact "null means guest" rule docs/01 §5.4 states. AMB-2's own
/// recommendation ("no" retroactive merge) means registering does NOT
/// backfill or link any prior guest Customer rows sharing the same
/// phone — a fresh row is created, deliberately orphaned from earlier
/// guest history.
model Customer {
  id                 String         @id @default(uuid(7)) @db.Uuid
  userId             String?        @unique @map("user_id") @db.Uuid
  fullName           String         @map("full_name")
  phone              String
  email              String?
  status             CustomerStatus @default(ACTIVE)
  /// BR-129 (Phase 12): account/order creation is explicitly NOT consent —
  /// this is set only by a future, dedicated opt-in action. `null` means
  /// no consent on record; `NotificationService` must never send a
  /// MARKETING-category notification while this is null, regardless of
  /// any NotificationPreference row.
  marketingConsentAt DateTime?      @map("marketing_consent_at") @db.Timestamptz
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  user                 User?                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  carts                Cart[]
  orders               Order[]
  promotionRedemptions PromotionRedemption[]
  reviews              Review[]
  loyaltyAccount       LoyaltyAccount?
  loyaltyLedgerEntries LoyaltyLedger[]
  loyaltyRedemptions   LoyaltyRedemption[]
  referralCode         ReferralCode?
  referralsReferred    Referral[]            @relation("Referrer")
  referredBy           Referral?             @relation("Referred")
  supportCases         SupportCase[]

  @@index([phone])
  // docs/01 §5.4: "unique on phone where user_id IS NOT NULL; guests
  // may repeat" — a real partial unique index, hand-written in this
  // phase's migration (Prisma's DSL cannot express a partial unique),
  // same treatment as Phase 14's `promotions_active_code_key`.
  @@map("customers")
}

/// Server-side cart — the browser's local copy (Phase 7/8) is for UX
/// only; this row is authoritative at checkout (docs/01 §5.5). Belongs
/// to exactly one restaurant (BR-16); a guest is identified by
/// `guestTokenHash` (same hash-stored/raw-token-returned-once pattern
/// as staff invitations and order access tokens below), a registered
/// customer by `customerId`.
model Cart {
  id             String     @id @default(uuid(7)) @db.Uuid
  restaurantId   String     @map("restaurant_id") @db.Uuid
  customerId     String?    @map("customer_id") @db.Uuid
  guestTokenHash String     @map("guest_token_hash")
  status         CartStatus @default(OPEN)
  expiresAt      DateTime   @map("expires_at") @db.Timestamptz
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items      CartItem[]

  @@index([guestTokenHash])
  @@index([restaurantId, status])
  @@map("carts")
}

/// `unitPriceMinorAtAdd` exists for price-drift detection only — never
/// authoritative for payment (BR-2, BR-20). A cart item is meaningless
/// without its cart and carries no financial/audit value of its own, so
/// this is the one place in the schema `onDelete: Cascade` is used for
/// a child that isn't purely denormalized data (docs/02 §6.1's deletion
/// policy explicitly allows this exception).
model CartItem {
  id                  String   @id @default(uuid(7)) @db.Uuid
  cartId              String   @map("cart_id") @db.Uuid
  menuItemId          String   @map("menu_item_id") @db.Uuid
  quantity            Int
  unitPriceMinorAtAdd BigInt   @map("unit_price_minor_at_add")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz

  cart     Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@index([cartId])
  @@map("cart_items")
}

/// The central financial and operational record — never deleted, no
/// snapshot field ever mutated after creation (docs/02 §6.3: "All
/// snapshot fields are immutable after creation"). `accessTokenHash`
/// backs guest order tracking (BR-35: "the order number alone is
/// insufficient") — the raw token is returned once, at checkout, and
/// never persisted in plaintext, same as every other token in this
/// codebase. The `order_total_consistent`/`order_discount_bounded`
/// CHECK constraints from docs/02 §6.3 are enforced at the service
/// layer (OrderStateService/CheckoutService), not the database — Prisma's
/// schema DSL cannot express multi-column CHECK constraints, the same
/// limitation already documented on several earlier models in this file.
model Order {
  id           String      @id @default(uuid(7)) @db.Uuid
  orderNumber  String      @map("order_number")
  restaurantId String      @map("restaurant_id") @db.Uuid
  customerId   String      @map("customer_id") @db.Uuid
  status       OrderStatus

  customerName    String @map("customer_name")
  customerPhone   String @map("customer_phone")
  deliveryAddress Json   @map("delivery_address")

  itemsSubtotalMinor   BigInt @map("items_subtotal_minor")
  packagingFeeMinor    BigInt @default(0) @map("packaging_fee_minor")
  deliveryFeeMinor     BigInt @default(0) @map("delivery_fee_minor")
  platformFeeMinor     BigInt @default(0) @map("platform_fee_minor")
  taxMinor             BigInt @default(0) @map("tax_minor")
  discountMinor        BigInt @default(0) @map("discount_minor")
  loyaltyDiscountMinor BigInt @default(0) @map("loyalty_discount_minor")
  payableTotalMinor    BigInt @map("payable_total_minor")
  currency             String @default("INR")
  pricingBreakdown     Json   @map("pricing_breakdown")

  promotionId          String? @map("promotion_id") @db.Uuid
  couponCode           String? @map("coupon_code")
  appliedLoyaltyPoints Int     @default(0) @map("applied_loyalty_points")

  idempotencyKey     String    @map("idempotency_key")
  accessTokenHash    String    @map("access_token_hash")
  placedAt           DateTime? @map("placed_at") @db.Timestamptz
  acceptedAt         DateTime? @map("accepted_at") @db.Timestamptz
  readyAt            DateTime? @map("ready_at") @db.Timestamptz
  deliveredAt        DateTime? @map("delivered_at") @db.Timestamptz
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz
  rejectionReason    String?   @map("rejection_reason")
  cancellationReason String?   @map("cancellation_reason")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  restaurant           Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  customer             Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  promotion            Promotion?            @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  items                OrderItem[]
  history              OrderStatusHistory[]
  payments             Payment[]
  delivery             Delivery?
  /// Many-to-one on the schema side (`orderId` is not itself `@unique` —
  /// only the composite `(promotionId, orderId)` is, per docs/01 §5.8),
  /// even though BR-93 (at most one promotion per order) means this is
  /// always zero or one row in practice, enforced at the application
  /// layer, not the database.
  promotionRedemptions PromotionRedemption[]
  review               Review?
  /// Zero or one — mirrors the promotionRedemptions comment above:
  /// `orderId` is unique on LoyaltyRedemption itself (not just a
  /// composite), so this is a genuine one-to-one, unlike promotions.
  loyaltyRedemption    LoyaltyRedemption?
  /// The referral this order QUALIFIED (BR-111: the referred customer's
  /// first order reaching DELIVERED) — not every order has one; most
  /// never do. See Referral.qualifyingOrderId.
  qualifyingReferral   Referral?
  supportCases         SupportCase[]

  @@unique([orderNumber])
  @@unique([restaurantId, idempotencyKey])
  @@index([restaurantId, status, createdAt(sort: Desc)])
  @@index([customerId, createdAt(sort: Desc)])
  @@map("orders")
}

/// Immutable line-item snapshot — `menuItemId` is kept only as a
/// reference for analytics; every field that actually mattered at order
/// time (name, price) is snapshotted directly, so a later menu edit or
/// archive never changes what a historical order displays (docs/01 §5.5).
model OrderItem {
  id                     String   @id @default(uuid(7)) @db.Uuid
  orderId                String   @map("order_id") @db.Uuid
  menuItemId             String   @map("menu_item_id") @db.Uuid
  nameSnapshot           String   @map("name_snapshot")
  descriptionSnapshot    String?  @map("description_snapshot")
  unitPriceMinorSnapshot BigInt   @map("unit_price_minor_snapshot")
  quantity               Int
  lineTotalMinor         BigInt   @map("line_total_minor")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_items")
}

/// Append-only — never updated or deleted through any API (BR-52).
/// `fromStatus` is null for the very first row (order creation has no
/// "from").
model OrderStatusHistory {
  id         String       @id @default(uuid(7)) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  actorType  String       @map("actor_type")
  actorId    String?      @map("actor_id") @db.Uuid
  reason     String?
  metadata   Json?
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  /// Phase 19 index review: `AnalyticsRollupService.rollupRestaurantDay`/
  /// `rollupPlatformDay` run a daily `toStatus = 'REJECTED' AND
  /// createdAt BETWEEN ...` count (the platform-wide one has no
  /// `orderId`/`restaurantId` to narrow it first) — `[orderId,
  /// createdAt]` above doesn't help that query at all.
  @@index([toStatus, createdAt])
  @@map("order_status_history")
}

/// `unique(provider, providerPaymentId)` is the primary defence against
/// duplicate webhook processing (docs/01 §5.6) — Postgres unique
/// constraints already treat NULL as distinct from every other NULL, so
/// this behaves exactly like the DDL's `WHERE provider_payment_id IS
/// NOT NULL` partial index without needing a raw-SQL migration for it.
/// Payment status is a field separate from Order.status — never merged.
model Payment {
  id                   String        @id @default(uuid(7)) @db.Uuid
  orderId              String        @map("order_id") @db.Uuid
  provider             String
  providerOrderId      String?       @map("provider_order_id")
  providerPaymentId    String?       @map("provider_payment_id")
  status               PaymentStatus
  amountMinor          BigInt        @map("amount_minor")
  capturedMinor        BigInt        @default(0) @map("captured_minor")
  refundedMinor        BigInt        @default(0) @map("refunded_minor")
  currency             String        @default("INR")
  method               String?
  failureCode          String?       @map("failure_code")
  failureMessage       String?       @map("failure_message")
  idempotencyKey       String        @map("idempotency_key")
  reconciliationStatus String        @default("OK") @map("reconciliation_status")
  authorizedAt         DateTime?     @map("authorized_at") @db.Timestamptz
  capturedAt           DateTime?     @map("captured_at") @db.Timestamptz
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refunds Refund[]

  @@unique([idempotencyKey])
  @@unique([provider, providerPaymentId])
  @@index([orderId])
  @@index([reconciliationStatus])
  @@map("payments")
}

/// Sum of non-FAILED refunds must never exceed `payment.capturedMinor`
/// (INV-6, BR-49) — enforced at the service layer by locking the
/// Payment row before creating a Refund (RefundService), the same
/// pattern the DDL's CHECK + row-lock combination describes.
model Refund {
  id                   String       @id @default(uuid(7)) @db.Uuid
  paymentId            String       @map("payment_id") @db.Uuid
  orderId              String       @map("order_id") @db.Uuid
  amountMinor          BigInt       @map("amount_minor")
  reason               String
  status               RefundStatus @default(REQUESTED)
  providerRefundId     String?      @map("provider_refund_id")
  initiatedByActorType String       @map("initiated_by_actor_type")
  initiatedByActorId   String?      @map("initiated_by_actor_id") @db.Uuid
  idempotencyKey       String       @map("idempotency_key")
  completedAt          DateTime?    @map("completed_at") @db.Timestamptz
  failureReason        String?      @map("failure_reason")
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([paymentId, idempotencyKey])
  @@unique([providerRefundId])
  @@index([orderId])
  @@map("refunds")
}

/// One per order (docs/02-database-schema.md §6.4, docs/03-state-
/// machines.md §7.4): `@@unique([orderId])` is the primary defence
/// against a duplicate dispatch — "mark ready" twice must create
/// exactly one delivery, and the second attempt hits this constraint
/// rather than a second row. `idempotencyKey` is separate from that
/// constraint and is what gets passed to the provider's own API, so a
/// retried provider call is itself idempotent on their side too (same
/// pattern as `Payment`/`Refund`). Delivery webhooks reuse the existing
/// `WebhookEvent` idempotency anchor (`provider` = `'mock_delivery'` /
/// `'uber_direct'`) rather than a second, parallel table — one webhook
/// processing pattern for every provider callback in the system, not
/// two independently-maintained copies of it.
model Delivery {
  id                  String         @id @default(uuid(7)) @db.Uuid
  orderId             String         @map("order_id") @db.Uuid
  provider            String
  providerDeliveryId  String?        @map("provider_delivery_id")
  status              DeliveryStatus
  pickupAddress       Json           @map("pickup_address")
  dropoffAddress      Json           @map("dropoff_address")
  courierName         String?        @map("courier_name")
  courierPhone        String?        @map("courier_phone")
  trackingUrl         String?        @map("tracking_url")
  quotedFeeMinor      BigInt?        @map("quoted_fee_minor")
  actualFeeMinor      BigInt?        @map("actual_fee_minor")
  idempotencyKey      String         @map("idempotency_key")
  attemptCount        Int            @default(0) @map("attempt_count")
  estimatedPickupAt   DateTime?      @map("estimated_pickup_at") @db.Timestamptz
  estimatedDeliveryAt DateTime?      @map("estimated_delivery_at") @db.Timestamptz
  pickedUpAt          DateTime?      @map("picked_up_at") @db.Timestamptz
  deliveredAt         DateTime?      @map("delivered_at") @db.Timestamptz
  cancellationReason  String?        @map("cancellation_reason")
  failureReason       String?        @map("failure_reason")
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderId])
  @@unique([provider, providerDeliveryId])
  @@map("deliveries")
}

/// docs/01 §5.8. `code` is required in this phase — "Customer coupon
/// entry" is the named frontend requirement (docs/13-implementation-
/// phases.md, Phase 14); `code: null` ("automatic" promotions the
/// domain model leaves room for) has no resolver built and is
/// deliberately deferred, not silently half-supported. `restaurantId:
/// null` means platform-wide (docs/01 §5.8) — enforced via the
/// `promotions:platform` permission (only ADMIN_OPERATIONS+ hold it;
/// `promotions:write`, which MANAGER/OWNER hold, only ever lets a
/// restaurant write ITS OWN `restaurantId`), not by any DB constraint.
/// `usage_count` is deliberately NOT a column here — PromotionRedemption
/// is the derived, race-safe source of truth (see its own doc comment).
model Promotion {
  id                    String        @id @default(uuid(7)) @db.Uuid
  restaurantId          String?       @map("restaurant_id") @db.Uuid
  code                  String
  name                  String
  type                  PromotionType
  /// PERCENTAGE: whole-number percent (1-100). FIXED_AMOUNT/FREE_DELIVERY: minor-unit amount (FREE_DELIVERY's value is advisory only — the actual discount is resolved against the order's real delivery fee at redemption time, never this stored value, so it can never exceed the fee actually charged).
  value                 Int
  minOrderMinor         BigInt?       @map("min_order_minor")
  maxDiscountMinor      BigInt?       @map("max_discount_minor")
  startsAt              DateTime?     @map("starts_at") @db.Timestamptz
  endsAt                DateTime?     @map("ends_at") @db.Timestamptz
  usageLimitTotal       Int?          @map("usage_limit_total")
  usageLimitPerCustomer Int?          @map("usage_limit_per_customer")
  firstOrderOnly        Boolean       @default(false) @map("first_order_only")
  isActive              Boolean       @default(true) @map("is_active")
  createdByUserId       String        @map("created_by_user_id") @db.Uuid
  archivedAt            DateTime?     @map("archived_at") @db.Timestamptz
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  restaurant  Restaurant?           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  redemptions PromotionRedemption[]
  orders      Order[]

  @@index([restaurantId])
  // docs/01 §5.8: "unique code where active and non-archived" is a
  // correctness constraint (two simultaneously-active promotions must
  // never share a lookup code), not a query-performance nicety — unlike
  // several earlier phases' plain-index-standing-in-for-partial-index
  // calls, this one is expressed as a REAL partial unique index via a
  // hand-written follow-up migration (docs/02-database-schema.md §6.1:
  // "add raw-SQL migrations for anything Prisma cannot express"), not
  // approximated. See migration `..._phase14_promotions_code_index`.
  @@map("promotions")
}

/// docs/01 §5.8, docs/03-state-machines.md §7.7's "Redemption sub-state".
/// The concurrency-safe usage record AND the reservation itself — the
/// same row serves both purposes, exactly like `WebhookEvent` is both
/// the idempotency anchor and the audit record for a webhook.
/// RESERVED (checkout, same transaction as Order creation) →
/// CONFIRMED (payment captured, ORDER_PLACED) or RELEASED (payment
/// failed/expired, ORDER_PAYMENT_FAILED/ORDER_EXPIRED) — driven by
/// `PromotionOutboxConsumer` registering with `OutboxService`
/// (Phase 12's `registerConsumer()` runtime hook), not a second poller.
/// BR-90: a CONFIRMED redemption is never released by a later
/// cancellation — cancellation has no edge to RELEASED at all.
///
/// Per-customer and first-order limits are enforced against
/// `customerPhone`, NOT `customerId` — `customerId` points at a fresh
/// `Customer` row `CheckoutService` creates on EVERY checkout (guest
/// checkout has no durable identity, AMB-2), so it can never recognise
/// a repeat customer. `customerPhone` (E.164-normalised, BR-26) is the
/// only signal that survives across a guest's separate orders, so it
/// is denormalised onto this row (the same call `Order.customerPhone`
/// already makes) and is what `PromotionReservationService` actually
/// queries for both limits. `customerId` is kept for referential/audit
/// consistency with docs/01 §5.8's documented field list, not dropped.
model PromotionRedemption {
  id            String                    @id @default(uuid(7)) @db.Uuid
  promotionId   String                    @map("promotion_id") @db.Uuid
  customerId    String                    @map("customer_id") @db.Uuid
  customerPhone String                    @map("customer_phone")
  orderId       String?                   @map("order_id") @db.Uuid
  status        PromotionRedemptionStatus @default(RESERVED)
  discountMinor BigInt                    @map("discount_minor")
  reservedAt    DateTime                  @default(now()) @map("reserved_at") @db.Timestamptz
  expiresAt     DateTime?                 @map("expires_at") @db.Timestamptz
  confirmedAt   DateTime?                 @map("confirmed_at") @db.Timestamptz

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  customer  Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order     Order?    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  // docs/01 §5.8: unique (promotion_id, order_id) — NULLs never collide
  // under Postgres unique-constraint semantics, so this is safe even
  // while order_id is briefly unset; in this codebase's actual checkout
  // flow (docs/04 §8.3 step 10) the Order row always exists in the same
  // transaction before this row is created, so order_id is set from
  // the start in practice.
  @@unique([promotionId, orderId])
  // Per-customer/total-usage limits are enforced by locking the
  // Promotion row (`SELECT ... FOR UPDATE`, docs/02 §6.3) and counting
  // through THIS index inside that same lock — not a partial unique
  // index on (promotion_id, customer_phone). A unique index can only
  // ever express "at most 1"; `usage_limit_per_customer` is an
  // arbitrary integer, so the lock-then-count pattern this codebase
  // already uses for Refund's INV-6 and the total-usage check here is
  // the one mechanism that correctly generalises to both.
  @@index([promotionId, status])
  @@index([promotionId, customerPhone, status])
  @@map("promotion_redemptions")
}

/// docs/01 §5.11. AMB-16: reviews publish immediately (`PUBLISHED` is
/// the entry status, not `PENDING_REVIEW` — pre-moderation is a
/// documented future option, off by default) with reactive moderation
/// triggered by a `ReviewReport`, not a pre-publish queue. `body` is
/// stored verbatim, untouched by any HTML sanitizer — BR-120's
/// "untrusted, never rendered as HTML" is enforced entirely by never
/// once using `dangerouslySetInnerHTML` on the frontend (React escapes
/// text content by default; the lint rule bans that API repo-wide),
/// the exact same posture already applied to restaurant names and menu
/// item descriptions.
model Review {
  id                String       @id @default(uuid(7)) @db.Uuid
  orderId           String       @unique @map("order_id") @db.Uuid
  customerId        String       @map("customer_id") @db.Uuid
  restaurantId      String       @map("restaurant_id") @db.Uuid
  rating            Int
  body              String?
  status            ReviewStatus @default(PUBLISHED)
  moderatedByUserId String?      @map("moderated_by_user_id") @db.Uuid
  moderationReason  String?      @map("moderation_reason")
  moderatedAt       DateTime?    @map("moderated_at") @db.Timestamptz
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  order      Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer   Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  restaurant Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  response   ReviewResponse?
  reports    ReviewReport[]

  // BR-118: one review per order — the actual concurrency guarantee
  // (docs/14-acceptance-criteria.md: "one review per order under
  // concurrency"), not an application-level pre-check.
  @@index([restaurantId, status, createdAt(sort: Desc)])
  @@map("reviews")
}

/// docs/01 §5.11. `reviewId` unique — BR-122: one public response per
/// review, enforced the same way `Review.orderId` enforces one review
/// per order.
model ReviewResponse {
  id           String   @id @default(uuid(7)) @db.Uuid
  reviewId     String   @unique @map("review_id") @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  authorUserId String   @map("author_user_id") @db.Uuid
  body         String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("review_responses")
}

/// docs/01 §5.11 — the trigger for AMB-16's reactive moderation model.
/// `reporterType` is `RESTAURANT` only in this phase — the endpoint
/// that would let a CUSTOMER report a review needs a stable identity to
/// dedupe against, which guest checkout (AMB-2) doesn't provide; a
/// restaurant reporting a review about itself already has one via its
/// existing tenant session, so that path is what's built. The schema
/// still allows `CUSTOMER` for when that identity exists (Phase 16+).
model ReviewReport {
  id           String             @id @default(uuid(7)) @db.Uuid
  reviewId     String             @map("review_id") @db.Uuid
  reporterType String             @map("reporter_type")
  reporterId   String             @map("reporter_id") @db.Uuid
  reason       String
  status       ReviewReportStatus @default(OPEN)
  resolvedBy   String?            @map("resolved_by") @db.Uuid
  resolvedAt   DateTime?          @map("resolved_at") @db.Timestamptz
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  // Prevents report spam (docs/01 §5.11) — the same reporter cannot
  // file a second report against the same review.
  @@unique([reviewId, reporterType, reporterId])
  @@index([status])
  @@map("review_reports")
}

// ─────────────────────────────────────────────────────────────────
// Loyalty and referrals (Phase 16) — docs/01-domain-model.md §5.9-5.10,
// docs/02-database-schema.md's loyalty_ledger/referrals DDL,
// docs/06-business-rules.md BR-97..BR-116.
// ─────────────────────────────────────────────────────────────────

/// docs/01 §5.9. `balancePoints` is a DERIVED CACHE (BR-97: "the ledger
/// is authoritative; the account balance is a derived cache reconciled
/// on a schedule") — every write to this row's balance/lifetime fields
/// happens in the SAME transaction as the LoyaltyLedger insert that
/// justifies it; no code path may change `balancePoints` on its own.
/// AMB-12: allowed to go negative after a clawback exceeds the current
/// balance — never clamped at zero, and redemption is blocked while
/// negative (enforced in LoyaltyRedemptionService, not here).
model LoyaltyAccount {
  id               String               @id @default(uuid(7)) @db.Uuid
  customerId       String               @unique @map("customer_id") @db.Uuid
  balancePoints    Int                  @default(0) @map("balance_points")
  lifetimeEarned   Int                  @default(0) @map("lifetime_earned")
  lifetimeRedeemed Int                  @default(0) @map("lifetime_redeemed")
  status           LoyaltyAccountStatus @default(ACTIVE)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@map("loyalty_accounts")
}

/// docs/01 §5.9. Append-only — "rows are never updated or deleted"
/// (BR-97). `points` is a plain signed Int (positive credit, negative
/// debit), NOT a money type — docs/02 §6.3's reference DDL has it as
/// `INTEGER`, not `BIGINT`. The `(type, referenceType, referenceId)`
/// uniqueness (hand-written partial index, see this phase's migration —
/// Prisma's DSL cannot express the `type <> 'ADMIN_ADJUSTMENT'`
/// condition) is what makes BR-99 ("an order can never award twice")
/// and the referral reward's BR-112 ("issued once ... through the
/// ledger's uniqueness") true at the storage layer, not just in
/// application logic — the same insert-and-let-the-constraint-decide
/// pattern used throughout this codebase since Phase 9.
model LoyaltyLedger {
  id            String            @id @default(uuid(7)) @db.Uuid
  customerId    String            @map("customer_id") @db.Uuid
  type          LoyaltyLedgerType
  points        Int
  referenceType String?           @map("reference_type")
  referenceId   String?           @map("reference_id") @db.Uuid
  description   String?
  actorType     String            @default("SYSTEM") @map("actor_type")
  actorId       String?           @map("actor_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  // No relation to LoyaltyAccount here (docs/01 §5.9's field list has
  // only customer_id, no account_id) — a repository queries this table
  // by customerId directly.
  @@index([customerId, createdAt(sort: Desc)])
  @@map("loyalty_ledger")
}

/// BR-101/BR-102: "redemption locks the account row; concurrent
/// redemptions cannot overdraw" and "reserved at checkout, confirmed on
/// payment capture, mirroring coupons" — the exact same RESERVED ->
/// CONFIRMED/RELEASED shape as PromotionRedemption, for the same reason:
/// docs/01 §5.9 lists only LoyaltyAccount/LoyaltyLedger, but "mirroring
/// coupons" is only achievable with a reservation row distinct from the
/// (append-only, never-reversed) ledger — a RELEASED row here simply
/// never produces a LoyaltyLedger entry, so the ledger stays a record of
/// genuine, permanent facts only. `discountMinor` is the resolved
/// minor-unit value of `points` at the redemption conversion rate
/// (LoyaltyRedemptionService's own doc comment — no spec source, a
/// code-level default same as Phase 15's Bayesian rating constants).
model LoyaltyRedemption {
  id            String                  @id @default(uuid(7)) @db.Uuid
  customerId    String                  @map("customer_id") @db.Uuid
  orderId       String?                 @unique @map("order_id") @db.Uuid
  points        Int
  discountMinor BigInt                  @map("discount_minor")
  status        LoyaltyRedemptionStatus @default(RESERVED)
  reservedAt    DateTime                @default(now()) @map("reserved_at") @db.Timestamptz
  expiresAt     DateTime?               @map("expires_at") @db.Timestamptz
  confirmedAt   DateTime?               @map("confirmed_at") @db.Timestamptz

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order    Order?   @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([customerId, status])
  @@map("loyalty_redemptions")
}

/// docs/01 §5.10. One active code per customer — generated on first
/// access to `/me/referrals` or `POST /auth/customer/otp/verify`
/// (whichever a customer reaches first), never pre-generated for every
/// account up front.
model ReferralCode {
  id         String   @id @default(uuid(7)) @db.Uuid
  customerId String   @unique @map("customer_id") @db.Uuid
  code       String   @unique
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@map("referral_codes")
}

/// docs/01 §5.10. BR-108 ("at most one referrer, ever" — enforced by
/// `@unique` on `referredCustomerId`) and BR-109 ("self-referral is
/// blocked by a database CHECK, not only by application logic" — hand-
/// written in this phase's migration, since Prisma's DSL cannot express
/// CHECK constraints, same limitation documented on Order/OrderItem
/// above) both hold at the storage layer. `referralCode` is a
/// denormalised text snapshot of the code used at attribution time, not
/// a foreign key — the same "survives independent of the live row"
/// treatment PromotionRedemption gives `customerPhone`. `qualifyingOrderId`
/// is plain `@unique` (not a hand-written partial index): Postgres
/// unique indexes already let multiple NULLs coexist, which is exactly
/// "unique only once qualified" without any extra work.
model Referral {
  referrerCustomerId String         @map("referrer_customer_id") @db.Uuid
  id                 String         @id @default(uuid(7)) @db.Uuid
  referredCustomerId String         @unique @map("referred_customer_id") @db.Uuid
  referralCode       String         @map("referral_code")
  status             ReferralStatus @default(PENDING)
  qualifyingOrderId  String?        @unique @map("qualifying_order_id") @db.Uuid
  attributedAt       DateTime       @default(now()) @map("attributed_at") @db.Timestamptz
  qualifiedAt        DateTime?      @map("qualified_at") @db.Timestamptz
  rewardedAt         DateTime?      @map("rewarded_at") @db.Timestamptz
  expiresAt          DateTime?      @map("expires_at") @db.Timestamptz

  referrer        Customer @relation("Referrer", fields: [referrerCustomerId], references: [id], onDelete: Restrict)
  referred        Customer @relation("Referred", fields: [referredCustomerId], references: [id], onDelete: Restrict)
  qualifyingOrder Order?   @relation(fields: [qualifyingOrderId], references: [id], onDelete: Restrict)

  @@index([referrerCustomerId, status])
  @@map("referrals")
}

/// The idempotency anchor for every provider callback (docs/01 §5.6).
/// Processing contract (docs/02 §6.3): verify signature → insert this
/// row → zero rows inserted (conflict) means duplicate, return 200
/// immediately and stop → otherwise process → return 200. A processing
/// failure must never produce a non-2xx response, or the provider
/// retries a webhook already stored here (BR-39, BR-40).
model WebhookEvent {
  id              String             @id @default(uuid(7)) @db.Uuid
  provider        String
  providerEventId String             @map("provider_event_id")
  eventType       String             @map("event_type")
  signatureValid  Boolean            @map("signature_valid")
  payload         Json
  status          WebhookEventStatus @default(RECEIVED)
  attempts        Int                @default(0)
  lastError       String?            @map("last_error")
  receivedAt      DateTime           @default(now()) @map("received_at") @db.Timestamptz
  processedAt     DateTime?          @map("processed_at") @db.Timestamptz

  @@unique([provider, providerEventId])
  @@index([provider, receivedAt])
  @@map("webhook_events")
}

/// Records mismatches; never silently corrects financial data (docs/01
/// §5.6). `expected`/`actual` are strings (not typed money) since this
/// table records mismatches across several different entity types, not
/// just payments.
model ReconciliationIssue {
  id             String                    @id @default(uuid(7)) @db.Uuid
  entityType     String                    @map("entity_type")
  entityId       String                    @map("entity_id") @db.Uuid
  issueType      String                    @map("issue_type")
  expected       String?
  actual         String?
  severity       ReconciliationSeverity
  status         ReconciliationIssueStatus @default(OPEN)
  resolutionNote String?                   @map("resolution_note")
  resolvedBy     String?                   @map("resolved_by") @db.Uuid
  detectedAt     DateTime                  @default(now()) @map("detected_at") @db.Timestamptz

  @@index([status, severity])
  @@index([entityType, entityId])
  @@map("reconciliation_issues")
}

/// Side effects (notifications, downstream events) are emitted here
/// AFTER the triggering transaction commits, never inside it
/// (docs/03-state-machines.md universal rule 4). Processed by a
/// lightweight in-process poller for now, not a real queue — see this
/// phase's report for why full job/queue infrastructure stays Phase 12
/// (apps/worker's own Phase 1 doc comment: "Real consumers ... attach
/// here starting Phase 12").
///
/// `restaurantId` (Phase 10) — nullable, no `@relation` (same reasoning
/// as AuditLog: an event record must remain exactly as recorded even if
/// the referenced restaurant is later modified, and must never be
/// blocked from being written by a foreign-key constraint). Lets the
/// restaurant order dashboard's SSE stream (`GET /restaurant/orders/
/// stream`) replay only its own tenant's events by `id` since a given
/// `Last-Event-ID`, without joining back through `orderId` on every
/// request. Events with no natural restaurant (none exist yet) leave
/// this null rather than a placeholder value.
model OutboxEvent {
  id           String       @id @default(uuid(7)) @db.Uuid
  eventType    String       @map("event_type")
  payload      Json
  status       OutboxStatus @default(PENDING)
  attempts     Int          @default(0)
  lastError    String?      @map("last_error")
  restaurantId String?      @map("restaurant_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  processedAt  DateTime?    @map("processed_at") @db.Timestamptz

  notifications Notification[]

  @@index([status, createdAt])
  @@index([restaurantId, id])
  @@map("outbox_events")
}

// ─────────────────────────────────────────────────────────────────
// Notifications (Phase 12)
// ─────────────────────────────────────────────────────────────────

/// Per-recipient, per-channel delivery record (docs/01-domain-model.md
/// §5.13, docs/02-database-schema.md §6.3). Deliberately no separate
/// `NotificationEvent` table — `OutboxEvent` already IS "the domain
/// event record" this system produces (id, type, payload, created_at),
/// the same reuse call Phase 11 made for `WebhookEvent`: one event-log
/// table, not two independently-maintained copies of the concept.
///
/// `@@unique([outboxEventId, recipientType, recipientId, channel])` is
/// THE guarantee against duplicate sends (docs/14.1: "Deduplication is
/// structural... duplicate events cannot produce duplicate messages") —
/// `NotificationService` always attempts an insert per (recipient,
/// channel) and lets the constraint decide, never a separate existence
/// check first.
///
/// Retry/backoff/dead-lettering (Phase 12's acceptance criteria) runs
/// on `attempts`/`nextAttemptAt` via the same lightweight in-process
/// poller pattern already used everywhere else in this codebase
/// (`OutboxService`'s own relay, `OrderExpiryScheduler`) — NOT the real
/// BullMQ queue docs/07-events-and-jobs.md §12 and this project's own
/// README describe for this phase. That migration is real, valuable
/// future work, not done here (this sandbox-honesty tradeoff mirrors
/// every other "in-memory fake instead of live infra" call made before
/// Docker became available, just applied to queueing instead of the
/// database) — see PHASE_REPORTS.md's Phase 12 entry for the reasoning.
model Notification {
  id                String                    @id @default(uuid(7)) @db.Uuid
  outboxEventId     String                    @map("outbox_event_id") @db.Uuid
  type              String
  category          NotificationCategory
  recipientType     NotificationRecipientType @map("recipient_type")
  recipientId       String                    @map("recipient_id") @db.Uuid
  channel           NotificationChannel
  title             String
  body              String
  /// Phone (E.164) or email address at the time of send — `null` for
  /// IN_APP. Snapshotted here, not re-looked-up from Customer/User at
  /// retry time: a recipient changing their phone number between the
  /// first failed attempt and a later retry must not silently redirect
  /// an in-flight notification to a different number.
  contactAddress    String?                   @map("contact_address")
  status            NotificationStatus        @default(PENDING)
  readAt            DateTime?                 @map("read_at") @db.Timestamptz
  attempts          Int                       @default(0)
  nextAttemptAt     DateTime?                 @map("next_attempt_at") @db.Timestamptz
  lastError         String?                   @map("last_error")
  providerMessageId String?                   @map("provider_message_id")
  sentAt            DateTime?                 @map("sent_at") @db.Timestamptz
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime                  @updatedAt @map("updated_at") @db.Timestamptz

  outboxEvent OutboxEvent @relation(fields: [outboxEventId], references: [id])

  @@unique([outboxEventId, recipientType, recipientId, channel])
  // Substitutes for docs/02 §6.3's two partial indexes (`WHERE read_at
  // IS NULL AND channel = 'IN_APP'`, `WHERE status = 'PENDING'`) —
  // Prisma's schema DSL has no partial-index attribute; a plain index
  // over the same leading columns is the correct, if less-optimized,
  // equivalent at pilot scale (same call Phase 11's `Delivery` model
  // made for its own partial unique index, documented there).
  @@index([recipientType, recipientId, createdAt(sort: Desc)])
  @@index([status, nextAttemptAt])
  @@map("notifications")
}

/// docs/01 §5.13. TRANSACTIONAL/SECURITY rows may exist but are never
/// honored as "disabled" — `NotificationPreferenceService` rejects any
/// attempt to write `enabled: false` for those two categories before
/// this table is ever touched, so the enforcement point is the service,
/// not "does a row happen to exist."
model NotificationPreference {
  id            String                    @id @default(uuid(7)) @db.Uuid
  recipientType NotificationRecipientType @map("recipient_type")
  recipientId   String                    @map("recipient_id") @db.Uuid
  category      NotificationCategory
  channel       NotificationChannel
  enabled       Boolean                   @default(true)
  createdAt     DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime                  @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([recipientType, recipientId, category, channel])
  @@map("notification_preferences")
}

// ─────────────────────────────────────────────────────────────────
// Audit
// ─────────────────────────────────────────────────────────────────

/// Append-only record of every privileged or state-changing action
/// (docs/02-database-schema.md, audit_logs). No `@relation` to the entities
/// it references: an audit record must remain exactly as it was recorded
/// even if the referenced restaurant/entity is later modified, and must
/// never be blocked from being written by a foreign-key constraint.
///
/// The application's own AuditRepository (apps/api/src/platform/audit)
/// exposes create + read only — no update, no delete — as the first layer
/// of enforcement. `prisma/grants.sql` revokes UPDATE/DELETE on this table
/// from the restricted runtime database role as the second, database-level
/// layer (defence in depth: an application bug reaching for `$executeRaw`
/// still cannot rewrite history).
model AuditLog {
  id            String   @id @default(uuid(7)) @db.Uuid
  actorType     String   @map("actor_type")
  actorId       String?  @map("actor_id") @db.Uuid
  action        String
  entityType    String   @map("entity_type")
  entityId      String?  @map("entity_id") @db.Uuid
  restaurantId  String?  @map("restaurant_id") @db.Uuid
  before        Json?
  after         Json?
  reason        String?
  correlationId String?  @map("correlation_id")
  ipHash        String?  @map("ip_hash")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([actorType, actorId, createdAt(sort: Desc)])
  @@index([restaurantId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────
// Support (Phase 17) — docs/01-domain-model.md §5.12,
// docs/03-state-machines.md §7.9, docs/06-business-rules.md
// BR-134..BR-140.
// ─────────────────────────────────────────────────────────────────

/// No spec source names these value sets (unlike the case status
/// state machine, which docs/03 §7.9 documents exactly) — a documented
/// code-level default, same treatment as Phase 15's Bayesian rating
/// constants and Phase 16's redemption conversion rate.
enum SupportCaseCategory {
  ORDER
  PAYMENT
  DELIVERY
  ACCOUNT
  RESTAURANT
  OTHER
}

enum SupportCasePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// docs/03-state-machines.md §7.9's exact state machine. SLA clocks
/// pause during the three WAITING_* states; enforced at the service
/// layer (SupportCaseService), not encoded as a schema constraint.
enum SupportCaseStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  WAITING_CUSTOMER
  WAITING_RESTAURANT
  WAITING_PROVIDER
  RESOLVED
  CLOSED
}

enum SupportMessageAuthorType {
  CUSTOMER
  RESTAURANT
  AGENT
  SYSTEM
}

/// BR-136: "INTERNAL notes are never returned to customer or
/// restaurant [...] enforce in the query layer, not by filtering in
/// the frontend" — every repository method a customer/restaurant
/// controller calls filters `visibility: 'PUBLIC'` in its own `WHERE`
/// clause; there is no method that returns unfiltered messages except
/// the admin/agent-only ones.
enum SupportMessageVisibility {
  INTERNAL
  PUBLIC
}

/// docs/01 §5.12. Ownership: "exactly one of customer_id/restaurant_id
/// identifies the reporter; both may be present when a case concerns
/// an order" — enforced at the service layer (a case is created via
/// either `/me/support/cases` or `/restaurant/support/cases`, never a
/// shared endpoint that accepts either id from the client), not a
/// database CHECK, matching this schema's established "the DSL can't
/// express an XOR-shaped constraint cleanly" precedent.
model SupportCase {
  id               String              @id @default(uuid(7)) @db.Uuid
  caseNumber       String              @unique @map("case_number")
  customerId       String?             @map("customer_id") @db.Uuid
  restaurantId     String?             @map("restaurant_id") @db.Uuid
  orderId          String?             @map("order_id") @db.Uuid
  category         SupportCaseCategory
  priority         SupportCasePriority @default(NORMAL)
  status           SupportCaseStatus   @default(OPEN)
  subject          String
  description      String
  assignedToUserId String?             @map("assigned_to_user_id") @db.Uuid
  resolvedAt       DateTime?           @map("resolved_at") @db.Timestamptz
  resolutionNote   String?             @map("resolution_note")
  /// BR/docs/03 §7.9: "time-to-first-response measures OPEN -> first
  /// PUBLIC agent message" — set once, the first time an AGENT-authored
  /// PUBLIC message is posted, never updated again.
  firstResponseAt  DateTime?           @map("first_response_at") @db.Timestamptz
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  customer   Customer?        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  restaurant Restaurant?      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order      Order?           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  messages   SupportMessage[]

  @@index([customerId, createdAt(sort: Desc)])
  @@index([restaurantId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([assignedToUserId, status])
  @@map("support_cases")
}

model SupportMessage {
  id         String                   @id @default(uuid(7)) @db.Uuid
  caseId     String                   @map("case_id") @db.Uuid
  authorType SupportMessageAuthorType @map("author_type")
  authorId   String?                  @map("author_id") @db.Uuid
  visibility SupportMessageVisibility @default(PUBLIC)
  body       String
  createdAt  DateTime                 @default(now()) @map("created_at") @db.Timestamptz

  case        SupportCase         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  attachments SupportAttachment[]

  @@index([caseId, createdAt])
  @@map("support_messages")
}

/// docs/01 §5.12, BR-140: "private, size- and type-validated, served
/// via short-lived signed URLs only." `caseId` is denormalised onto
/// this row alongside `messageId` (the same "avoid a join for every
/// tenant/ownership check" call `PromotionRedemption.customerPhone`
/// already makes) — an attachment's own case-membership check never
/// needs to join through `SupportMessage` first.
model SupportAttachment {
  id             String   @id @default(uuid(7)) @db.Uuid
  caseId         String   @map("case_id") @db.Uuid
  messageId      String   @map("message_id") @db.Uuid
  uploadedByType String   @map("uploaded_by_type")
  uploadedById   String?  @map("uploaded_by_id") @db.Uuid
  objectKey      String   @map("object_key")
  filename       String
  contentType    String   @map("content_type")
  sizeBytes      Int      @map("size_bytes")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  message SupportMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@map("support_attachments")
}

// ─────────────────────────────────────────────────────────────────
// Analytics (Phase 17) — docs/01-domain-model.md §5.14.
// ─────────────────────────────────────────────────────────────────

/// docs/01 §5.14: "append-only... never contains PII beyond internal
/// identifiers; never used as a transactional source of truth." A
/// lower-fidelity event stream for future BI/funnel use — the daily
/// rollups below are deliberately NOT computed from this table (see
/// `AnalyticsRollupService`'s own doc comment); they recompute directly
/// from `Order`/`Payment`/`Refund`, the actual source of truth, so
/// "rollups reconcile with source data" holds by construction rather
/// than depending on this ingest pipeline never dropping an event.
model AnalyticsEvent {
  id             String   @id @default(uuid(7)) @db.Uuid
  type           String
  occurredAt     DateTime @map("occurred_at") @db.Timestamptz
  sessionId      String?  @map("session_id")
  customerId     String?  @map("customer_id") @db.Uuid
  restaurantId   String?  @map("restaurant_id") @db.Uuid
  orderId        String?  @map("order_id") @db.Uuid
  properties     Json?
  /// Dedupes a re-relayed outbox event the same way every other
  /// consumer in this codebase does — insert-and-let-the-constraint-
  /// decide, not a pre-check.
  idempotencyKey String?  @unique @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([type, occurredAt])
  @@index([restaurantId, occurredAt])
  @@map("analytics_events")
}

/// docs/01 §5.14. "Unique (restaurant_id, date); recomputable and
/// idempotent" — `AnalyticsRollupService.rollupRestaurantDay` always
/// upserts, so re-running it for an already-rolled-up day is safe and
/// produces the identical row, never a duplicate. `date` is a plain
/// calendar date (`@db.Date`, no time-of-day component) in the
/// restaurant's OWN timezone (`RestaurantSettings.timezone`), computed
/// via `localMidnightToUtc`/`toLocalMoment` — never the server's.
model DailyRestaurantMetrics {
  id                   String   @id @default(uuid(7)) @db.Uuid
  restaurantId         String   @map("restaurant_id") @db.Uuid
  date                 DateTime @db.Date
  ordersPlaced         Int      @default(0) @map("orders_placed")
  ordersCompleted      Int      @default(0) @map("orders_completed")
  ordersCancelled      Int      @default(0) @map("orders_cancelled")
  ordersRejected       Int      @default(0) @map("orders_rejected")
  grossOrderValueMinor BigInt   @default(0) @map("gross_order_value_minor")
  discountMinor        BigInt   @default(0) @map("discount_minor")
  refundMinor          BigInt   @default(0) @map("refund_minor")
  netOrderValueMinor   BigInt   @default(0) @map("net_order_value_minor")
  avgOrderValueMinor   BigInt   @default(0) @map("avg_order_value_minor")
  avgPrepSeconds       Int      @default(0) @map("avg_prep_seconds")
  computedAt           DateTime @default(now()) @map("computed_at") @db.Timestamptz

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, date])
  @@map("daily_restaurant_metrics")
}

/// docs/01 §5.14: "same shape at platform scope, plus payment success
/// rate, delivery success rate, and support case counts." Success
/// rates are stored as raw counts (`paymentsAttempted`/
/// `paymentsSucceeded`, `deliveriesAttempted`/`deliveriesSucceeded`),
/// never a pre-divided float — BR-1's "no floating-point arithmetic on
/// money" doesn't literally cover a percentage, but storing the counts
/// keeps the row itself trivially reconcilable and the rate computation
/// (division) happens once, at the read/display layer, not baked into
/// the stored row.
model DailyPlatformMetrics {
  id                   String   @id @default(uuid(7)) @db.Uuid
  date                 DateTime @db.Date
  ordersPlaced         Int      @default(0) @map("orders_placed")
  ordersCompleted      Int      @default(0) @map("orders_completed")
  ordersCancelled      Int      @default(0) @map("orders_cancelled")
  ordersRejected       Int      @default(0) @map("orders_rejected")
  grossOrderValueMinor BigInt   @default(0) @map("gross_order_value_minor")
  discountMinor        BigInt   @default(0) @map("discount_minor")
  refundMinor          BigInt   @default(0) @map("refund_minor")
  netOrderValueMinor   BigInt   @default(0) @map("net_order_value_minor")
  avgOrderValueMinor   BigInt   @default(0) @map("avg_order_value_minor")
  avgPrepSeconds       Int      @default(0) @map("avg_prep_seconds")
  paymentsAttempted    Int      @default(0) @map("payments_attempted")
  paymentsSucceeded    Int      @default(0) @map("payments_succeeded")
  deliveriesAttempted  Int      @default(0) @map("deliveries_attempted")
  deliveriesSucceeded  Int      @default(0) @map("deliveries_succeeded")
  supportCasesOpened   Int      @default(0) @map("support_cases_opened")
  computedAt           DateTime @default(now()) @map("computed_at") @db.Timestamptz

  @@unique([date])
  @@map("daily_platform_metrics")
}
