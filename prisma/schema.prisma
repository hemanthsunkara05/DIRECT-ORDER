// Direct-Order — Prisma schema
//
// Phase 1 (Foundation) deliberately has ZERO domain models. Its only
// job is to prove the migration pipeline works: `prisma generate`
// produces a usable client, and `prisma migrate dev` can create and
// apply a migration against a real database.
//
// Domain models (User, Restaurant, MenuItem, Order, ...) arrive in
// Phase 2 per PRODUCT/docs/13-implementation-phases.md, following the
// exact schema in PRODUCT/docs/02-database-schema.md. Do not add
// models here ahead of that phase.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
